# Copy to .env (never commit .env). All keys stay on the server.
PORT=8090
ORBIS_OFFLINE=0            # 1 = never contact providers (demo mode, everything labelled DEMO/SAMPLE)

# Optional provider keys (each unlocks a module/feature; without it ORBIS says CONFIGURATION REQUIRED)
TWELVEDATA_KEY=            # stocks, indices, metals, commodities
FRED_API_KEY=              # US macro series (Economy)
NASA_API_KEY=              # near-Earth asteroids; DEMO_KEY is used if empty (heavily rate limited)
ANTHROPIC_API_KEY=         # AI Analyst
ANALYST_MODEL=claude-sonnet-4-5

# Enables the API Management Center admin actions (test connection, register provider)
ORBIS_ADMIN_TOKEN=
ORBIS_DB=data/orbis.db      # SQLite recorder file
ORBIS_SCHEDULER=1           # 0 = do not run background collectors
ORBIS_CONTACT=              # contact email/URL for the SEC EDGAR User-Agent
