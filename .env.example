# Copy to .env (never commit .env). All keys are OPTIONAL; without them the matching feed shows clearly-labelled DEMO data.
PORT=8090
# Stocks / indices / commodities / metals quotes (https://twelvedata.com, free tier has rate limits)
TWELVEDATA_KEY=
# AI Analyst (server-side only; never sent to the browser)
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-4-5
# Set to 1 to stop all outbound data requests (forces DEMO/offline mode)
ORBIS_OFFLINE=0
